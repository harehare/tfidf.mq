import "tfidf"
| include "test"

def assert_close(actual, expected):
  assert_true(abs(actual - expected) < 0.000000001)
end

def fails(f): try: f() catch: "failed";

def corpus():
  ["the cat sat on the mat", "the dog chased the cat", "dogs and cats are pets", "quantum field theory"]
end

def ids(results): map(results, fn(p): p[1];);

# =========================================================================
# tokenize
# =========================================================================

def test_tokenize_lowercases_and_splits_on_punctuation():
  assert_eq(tfidf::tokenize("Hello, World!"), ["hello", "world"])
end

def test_tokenize_splits_on_underscores_and_keeps_digits():
  assert_eq(tfidf::tokenize("x_y 3rd"), ["x", "y", "3rd"])
end

def test_tokenize_keeps_repeated_words():
  assert_eq(tfidf::tokenize("a a b"), ["a", "a", "b"])
end

def test_tokenize_of_empty_and_symbol_only_text():
  assert_eq(tfidf::tokenize(""), [])
  | assert_eq(tfidf::tokenize("  ,.! "), [])
end

def test_tokenize_leaves_unspaced_text_as_one_token():
  assert_eq(tfidf::tokenize("日本語 テキスト"), ["日本語", "テキスト"])
end

def test_tokenize_ignores_leading_and_trailing_separators():
  assert_eq(tfidf::tokenize("--a--b--"), ["a", "b"])
end

# =========================================================================
# build
# =========================================================================

def test_build_counts_documents_and_tokens():
  let ix = tfidf::build(corpus())
  | assert_eq(ix["n"], 4)
  | assert_eq(ix["lens"], [6, 5, 5, 3])
  | assert_close(ix["avg"], 4.75)
end

def test_build_counts_document_frequency_once_per_document():
  let ix = tfidf::build(corpus())
  | assert_eq(ix["df"]["the"], 2)
  | assert_eq(ix["df"]["cat"], 2)
  | assert_eq(ix["df"]["quantum"], 1)
end

def test_build_counts_term_frequency_per_document():
  let ix = tfidf::build(corpus())
  | assert_eq(ix["tfs"][0]["the"], 2)
  | assert_eq(ix["tfs"][0]["cat"], 1)
end

def test_build_of_no_documents():
  let ix = tfidf::build([])
  | assert_eq(ix["n"], 0)
  | assert_eq(ix["avg"], 0)
end

def test_build_with_an_empty_document():
  let ix = tfidf::build(["", "cat"])
  | assert_eq(ix["lens"], [0, 1])
  | assert_eq(ix["n"], 2)
end

def test_build_with_a_custom_tokenizer():
  let ix = tfidf::build_with(["a-b", "a-c"], fn(s): split(s, "-");)
  | assert_eq(ix["df"]["a"], 2)
  | assert_eq(ix["df"]["b"], 1)
end

def test_build_does_not_modify_its_input():
  let docs = corpus()
  | let _ = tfidf::build(docs)
  | assert_eq(docs, corpus())
end

# =========================================================================
# idf
# =========================================================================

def test_idf_is_larger_for_rarer_terms():
  let ix = tfidf::build(corpus())
  | assert_true(tfidf::idf(ix, "quantum") > tfidf::idf(ix, "cat"))
  | assert_true(tfidf::idf(ix, "cat") > tfidf::idf(ix, "dog") - 1)
end

def test_idf_of_an_unknown_term_is_the_largest():
  let ix = tfidf::build(corpus())
  | assert_true(tfidf::idf(ix, "zebra") > tfidf::idf(ix, "quantum"))
end

def test_idf_stays_positive_for_a_term_in_every_document():
  let ix = tfidf::build(["a b", "a c", "a d"])
  | assert_true(tfidf::idf(ix, "a") > 0)
end

def test_idf_matches_the_bm25_formula():
  let ix = tfidf::build(corpus())
  | assert_close(tfidf::idf(ix, "quantum"), log(1 + (4 - 1 + 0.5) / (1 + 0.5)))
end

# =========================================================================
# search
# =========================================================================

def test_search_ranks_a_shorter_matching_document_higher():
  let r = tfidf::search(tfidf::build(corpus()), "cat", 3)
  | assert_eq(ids(r), [1, 0])
end

def test_search_scores_a_single_document_exactly():
  let r = tfidf::search(tfidf::build(["cat"]), "cat", 1)
  | assert_close(r[0][0], log(4 / 3))
  | assert_eq(r[0][1], 0)
end

def test_search_scores_follow_the_bm25_formula_when_a_document_is_not_of_average_length():
  let ix = tfidf::build(["cat", "dog bird fish"])
  | let short = tfidf::search(ix, "cat", 1)
  | let long = tfidf::search(ix, "dog", 1)
  | assert_close(short[0][0], log(2) * 2.5 / (1 + 1.5 * (0.25 + 0.75 * 1 / 2)))
  | assert_close(long[0][0], log(2) * 2.5 / (1 + 1.5 * (0.25 + 0.75 * 3 / 2)))
end

def test_search_scores_are_positive_and_descending():
  let r = tfidf::search(tfidf::build(corpus()), "the cat dog", 4)
  | assert_true(len(r) >= 2)
  | assert_true(r[0][0] >= r[1][0])
  | assert_true(r[len(r) - 1][0] > 0)
end

def test_search_leaves_out_documents_without_a_matching_term():
  let r = tfidf::search(tfidf::build(corpus()), "quantum", 4)
  | assert_eq(ids(r), [3])
end

def test_search_with_no_match_is_empty():
  assert_eq(tfidf::search(tfidf::build(corpus()), "zebra", 3), [])
end

def test_search_prefers_documents_with_rarer_terms():
  let ix = tfidf::build(["common rare", "common common", "common other"])
  | assert_eq(ids(tfidf::search(ix, "common rare", 3))[0], 0)
end

def test_search_rewards_repeated_terms_with_diminishing_returns():
  let ix = tfidf::build(["cat x", "cat cat x x", "dog x"])
  | let r = tfidf::search(ix, "cat", 2)
  | assert_eq(ids(r), [1, 0])
  | assert_true(r[0][0] < 2 * r[1][0])
end

def test_search_ignores_repeated_query_terms():
  let ix = tfidf::build(corpus())
  | assert_eq(tfidf::search(ix, "cat cat cat", 3), tfidf::search(ix, "cat", 3))
end

def test_search_is_case_insensitive():
  let ix = tfidf::build(corpus())
  | assert_eq(tfidf::search(ix, "CAT", 3), tfidf::search(ix, "cat", 3))
end

def test_search_limits_results_to_k():
  let ix = tfidf::build(corpus())
  | assert_eq(len(tfidf::search(ix, "the cat dog", 1)), 1)
  | assert_eq(len(tfidf::search(ix, "the cat dog", 10)), 2)
end

def test_search_with_non_positive_k_or_empty_query():
  let ix = tfidf::build(corpus())
  | assert_eq(tfidf::search(ix, "cat", 0), [])
  | assert_eq(tfidf::search(ix, "cat", -1), [])
  | assert_eq(tfidf::search(ix, "", 3), [])
  | assert_eq(tfidf::search(ix, "!!!", 3), [])
end

def test_search_of_an_empty_index():
  assert_eq(tfidf::search(tfidf::build([]), "cat", 3), [])
end

def test_search_ties_go_to_the_earlier_document():
  let ix = tfidf::build(["cat", "cat", "cat"])
  | assert_eq(ids(tfidf::search(ix, "cat", 3)), [0, 1, 2])
end

def test_search_skips_empty_documents():
  let ix = tfidf::build(["", "cat", ""])
  | assert_eq(ids(tfidf::search(ix, "cat", 3)), [1])
end

def test_search_tokens_takes_already_split_terms():
  let ix = tfidf::build(corpus())
  | assert_eq(tfidf::search_tokens(ix, ["cat"], 3), tfidf::search(ix, "cat", 3))
end

def test_search_with_a_custom_tokenizer():
  let ix = tfidf::build_with(["a-b", "a-c", "d"], fn(s): split(s, "-");)
  | assert_eq(ids(tfidf::search_tokens(ix, ["b"], 3)), [0])
  | assert_eq(ids(tfidf::search_tokens(ix, ["a"], 3)), [0, 1])
end

def test_search_does_not_modify_the_index():
  let ix = tfidf::build(corpus())
  | let _ = tfidf::search(ix, "the cat", 3)
  | assert_eq(ix, tfidf::build(corpus()))
end

# =========================================================================
# keywords
# =========================================================================

def test_keywords_prefer_terms_that_set_the_document_apart():
  let ix = tfidf::build(corpus())
  | let r = tfidf::keywords(ix, 3, 3)
  | assert_eq(len(r), 3)
  | assert_eq(sort(map(r, fn(p): p[1];)), ["field", "quantum", "theory"])
end

def test_keywords_score_is_share_times_idf():
  let ix = tfidf::build(corpus())
  | let r = tfidf::keywords(ix, 3, 1)
  | assert_close(r[0][0], 1 / 3 * log(4))
end

def test_keywords_leave_out_terms_found_in_every_document():
  let ix = tfidf::build(["a x", "a y", "a z"])
  | let terms = map(tfidf::keywords(ix, 0, 5), fn(p): p[1];)
  | assert_eq(terms, ["x"])
end

def test_keywords_are_ordered_by_score():
  let ix = tfidf::build(["rare rare common x", "common y", "common z"])
  | let r = tfidf::keywords(ix, 0, 5)
  | assert_eq(r[0][1], "rare")
end

def test_keywords_limit_to_k():
  let ix = tfidf::build(corpus())
  | assert_eq(len(tfidf::keywords(ix, 3, 2)), 2)
  | assert_eq(tfidf::keywords(ix, 3, 0), [])
end

def test_keywords_of_an_empty_document():
  assert_eq(tfidf::keywords(tfidf::build(["", "cat"]), 0, 3), [])
end

def test_keywords_reject_an_unknown_document():
  let ix = tfidf::build(corpus())
  | assert_eq(fails(fn(): tfidf::keywords(ix, 4, 2);), "failed")
  | assert_eq(fails(fn(): tfidf::keywords(ix, -1, 2);), "failed")
end
